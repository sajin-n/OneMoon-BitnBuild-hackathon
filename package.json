{
  "name": "onemoon-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "OneMoon - Cybersecurity & Threat Intelligence Platform",
  "scripts": {
    "dev:api": "pnpm --filter @onemoon/api dev",
    "dev:dashboard": "pnpm --filter @onemoon/dashboard dev",
    "dev:extension": "pnpm --filter @onemoon/extension dev",
    "dev:ml": "python -m uvicorn app.main:app --reload --app-dir apps/ml-service --port 8000",
    "build": "pnpm --filter \"@onemoon/*\" build",
    "build:api": "pnpm --filter @onemoon/api build",
    "build:dashboard": "pnpm --filter @onemoon/dashboard build",
    "build:extension": "pnpm --filter @onemoon/extension build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}
